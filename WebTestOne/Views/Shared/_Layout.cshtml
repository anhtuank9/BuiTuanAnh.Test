<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0194f3" />
    <title>@ViewData["Title"] - Book Online</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebTestOne.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="site-shell">
        <header class="site-header">
            <a class="brand-banner" asp-controller="Home" asp-action="Index" aria-label="Book Online - Trang chủ">
                <img src="~/images/nen_banner.jpg" alt="Book Online" />
            </a>
            <div class="banner-message">
                <span class="eyebrow">Thư viện trực tuyến</span>
                <strong>Mỗi trang sách, một chân trời mới</strong>
                <span>Chọn sách hay · Giao nhanh · Mua sắm thuận tiện</span>
            </div>
        </header>

        <nav class="top-nav" aria-label="Điều hướng chính">
            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-site-nav-toggle>
                <span aria-hidden="true">☰</span> Danh mục
            </button>
            <div class="top-nav-inner" id="primary-nav" data-site-nav>
                <div class="nav-links">
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <a asp-controller="Sach" asp-action="Index">Danh mục sách</a>
                    <a asp-controller="Account" asp-action="Register">Đăng ký</a>
                    <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <a asp-controller="Sach" asp-action="ChuDe">Quản lý chủ đề</a>
                        <a asp-controller="Sach" asp-action="QueryDemo">Truy vấn CSDL</a>
                    }
                </div>
                <div class="account-links">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span>Xin chào, <strong>@User.Identity.Name</strong></span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    }
                </div>
            </div>
        </nav>

        <div class="store-grid">
            <aside class="left-sidebar">
                @await Component.InvokeAsync("BookTopics")
            </aside>

            <main class="store-main" role="main">
                @await Component.InvokeAsync("NewBooks")
                @await Component.InvokeAsync("RandomAds")

                @if (TempData["CartMessage"] is string cartMessage)
                {
                    <div class="notice notice-success" role="status">@cartMessage</div>
                }

                <div class="main-surface">
                    @RenderBody()
                </div>
            </main>

            <aside class="right-sidebar">
                @await Component.InvokeAsync("CartSummary")
                @await Component.InvokeAsync("ActiveAds")
                @await Component.InvokeAsync("BestSellers")
            </aside>
        </div>

        <footer class="site-footer">
            <strong>Book Online</strong>
            <span>© 2026 · 189 Nguyễn Lương Bằng, Đà Nẵng · Điện thoại: 0236 3 888 999</span>
            <span>Hỗ trợ: bookonline@viu.edu.vn</span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
