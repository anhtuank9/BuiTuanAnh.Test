@model IReadOnlyList<SidebarBookViewModel>

<section class="new-books-strip" aria-labelledby="new-books-heading">
    <div class="strip-title">
        <span>Sách mới</span>
        <a asp-controller="Sach" asp-action="Index">Xem tất cả</a>
    </div>
    <div class="new-books-links" id="new-books-heading">
        @foreach (var book in Model)
        {
            <a asp-controller="Sach" asp-action="Details" asp-route-id="@book.Id">@book.Name</a>
        }
        @if (Model.Count == 0)
        {
            <span>Danh mục đang được cập nhật.</span>
        }
    </div>
</section>
