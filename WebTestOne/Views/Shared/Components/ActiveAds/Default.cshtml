@model IReadOnlyList<AdvertisementViewModel>

<section class="sidebar-card partner-panel" aria-label="Đối tác Book Online">
    <div class="partner-media-list">
        @foreach (var ad in Model)
        {
            <a class="partner-media-link" href="@ad.Link" target="_blank" rel="noopener">
                <img src="@ad.ImageUrl" alt="@ad.CompanyName" onerror="this.src='/images/QC_BEN.jpg'" />
            </a>
        }
        @if (Model.Count == 0)
        {
            <p class="empty-note">Chưa có nội dung đối tác đang hoạt động.</p>
        }
    </div>
</section>
