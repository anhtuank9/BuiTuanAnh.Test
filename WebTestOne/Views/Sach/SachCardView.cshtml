@using WebTestOne.Models
@model List<SachViewModel>

@{
    ViewData["Title"] = "Danh mục sách";
}

<section class="catalog-section">
    <header class="section-heading">
        <div>
            <span class="eyebrow">Danh mục</span>
            <h1>@ViewBag.PageHeading</h1>
        </div>
        <span class="result-count">@Model.Count đầu sách</span>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="book-grid">
            @foreach (SachViewModel s in Model)
            {
                <article class="book-card">
                    <a class="book-cover" asp-action="Details" asp-route-id="@s.Ms">
                        <img src="@s.ImageUrl" alt="Bìa sách @s.TenSach" onerror="this.src='/images/new.jpg'" />
                    </a>
                    <div class="book-info">
                        <span class="book-topic">@(s.TenChuDe ?? "Sách chọn lọc")</span>
                        <h2><a asp-action="Details" asp-route-id="@s.Ms">@s.TenSach</a></h2>
                        <p class="book-author">@(string.IsNullOrWhiteSpace(s.TacGia) ? "Tác giả đang cập nhật" : s.TacGia)</p>
                        <p class="book-publisher">@(s.TenNXB ?? "Nhà xuất bản đang cập nhật")</p>
                        <p class="book-description">@s.MoTa</p>
                        <div class="book-purchase">
                            <strong>@((s.DonGia ?? 0).ToString("#,##0 'đ'"))</strong>
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="id" value="@s.Ms" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit">Chọn mua</button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <span aria-hidden="true">📚</span>
            <h2>Chưa có sách trong chủ đề này</h2>
            <p>Bạn có thể chọn một chủ đề khác hoặc xem toàn bộ danh mục.</p>
            <a class="primary-action" asp-action="Index">Xem tất cả sách</a>
        </div>
    }
</section>
