@using WebTestOne.Models
@model List<Sach>

@{
    ViewData["Title"] = "Danh mục đề sách";
}

<style>
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }
    th, td {
        border: 1px solid #dee2e6;
        padding: 8px 12px;
        text-align: center;
        vertical-align: middle;
    }
    th {
        background-color: #f8f9fa;
        font-weight: 600;
    }
</style>

<h2>@ViewData["Title"]</h2>

<a asp-action="SachCreate" class="btn btn-primary mb-3">Thêm sách mới</a>

@if (Model != null && Model.Any())
{
    <table>
        <thead>
            <tr>
                <th style="width: 8%;">Mã sách</th>
                <th style="width: 25%;">Tên sách</th>
                <th style="width: 12%;">Đơn giá</th>
                <th style="width: 15%;">Hình minh họa</th>
                <th style="width: 25%;">Mô tả</th>
                <th style="width: 15%;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Sach s in Model)
            {
                <tr>
                    <td>@s.Ms</td>
                    <td>@s.TenSach</td>
                    <td>@s.DonGia</td>

                    @* Chuyển từ hiển thị tên file sang thẻ img hiển thị ảnh trực quan *@
                    <td>
                        <img src=@("/images/" + s.HinhMinhHoa + ".jpg")
                             alt="Image"
                             width="100"
                             height="100" />
                    </td>

                    <td>@s.MoTa</td>
                    <td>
                        <a asp-action="SachDetail" asp-route-id="@s.Ms" class="btn btn-danger btn-sm">Chi tiết</a>
                        <a asp-action="SachEdit" asp-route-id="@s.Ms" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="SachDelete" asp-route-id="@s.Ms" class="btn btn-danger btn-sm">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Chưa có dữ liệu sách nào trong hệ thống.</p>
}